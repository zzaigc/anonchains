# Cross-platform line endings. Shell scripts MUST stay LF or the shebang
# (#!/usr/bin/env bash) breaks on Linux/macOS after a Windows checkout.
* text=auto
*.sh text eol=lf
*.py text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.conf text eol=lf
*.txt text eol=lf
*.toml text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf
